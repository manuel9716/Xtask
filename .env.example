# Database Configuration
# ============================================
# Elige UNA de las siguientes opciones:

# OPCIÓN 1: SQL Server 2019 Local (ACTUAL)
DATABASE_URL=mssql://sa:Str0ng!Passw0rd@localhost:1433/Xtask_dev

# OPCIÓN 2: PostgreSQL Local (Docker)
# DATABASE_URL=postgresql://xtaskflow_user:XtaskFlow2024!@localhost:5432/xtaskflow_db

# OPCIÓN 3: PostgreSQL en Neon (Producción)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Node Environment
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Email Configuration (SendGrid)
# Opcional - solo necesario si usas funcionalidades de email
SENDGRID_API_KEY=

# Server Configuration
PORT=5000

# Google Cloud Storage (Opcional)
# Solo si usas almacenamiento en la nube
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Stripe (Opcional)
# Solo si usas pagos
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# OpenAI (Opcional)
# Solo si usas funcionalidades de IA
OPENAI_API_KEY=
